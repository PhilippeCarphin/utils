#!/usr/bin/env bash

saved_stty_settings="$(stty -g)"
stty -echo
trap 'cleanup' EXIT
cleanup(){

    if [[ -n ${tail_pid} ]] ; then
        ps -f ${tail_pid}
        debug "Killing tail process ${tail_pid}"
        kill -- -${tail_pid}
        debug "Waiting for tail process to finish"
        wait
        debug "Tail process ended"
    fi
    stty "${saved_stty_settings}"
}

tail='tail -f'
poll_seconds=5
verbose=false
while getopts "asvp:" the_opt ; do
    case ${the_opt} in
        s) tail=short-tail ;;
        a) tail=tail-with-header ;;
        p) poll_seconds=${OPTARG} ;;
        v) verbose=true ;;
        '?') exit 1 ;;
    esac
done
shift $((OPTIND-1))
glob=$1

if ${verbose} ; then
    debug(){
        printf "\033[38;5;242m${0##*/}: %s\033[0m\n" "$*"
    }
else
    debug(){ : ; }
fi

get-files(){
    # Not sure how else I would sort the files produced by find creation order
    # without double-stat'ing.
    # - I don't know how to make 'ls' only give regular files
    # - I don't know how to make find sort its output by time
    cmd=(find . -mindepth 1 -maxdepth 1 -type f)
    if [[ -n $1 ]] ; then
        cmd+=(-name "$1")
    fi
    "${cmd[@]}" | xargs ls -t
}

prev_nb_files=0
while true ; do
    files=($(get-files $glob))
    nb_files=${#files[@]}
    if (( nb_files > prev_nb_files )) ; then
        debug "New file detected"
        prev_nb_files=${nb_files}
        if [[ -n ${tail_pid:-} ]] ; then
            debug "Killing previous tail process ${tail_pid}"
            kill ${tail_pid}
            debug "Waiting for previous tail process to finish"
            wait
            debug "Tail process ended"
        fi
        printf "\033[1;32mTailing new file ${files[0]}\033[0m\n"

        # I don't remember why I put this there.  Probably for some debugging
        # purpose.
        if [[ -n ${2:-} ]] ; then
            sleep 5
        fi

        # Note: Need to reopen dev/tty because the program is goin in
        # background and without this, the `stty` in short-tail would
        # fail with `stty: 'standard input': Inappropriate ioctl for device`
        # ${tail} ${files[0]} </dev/tty &
        #
        # Using setsid, we start the tail process in its own session and
        # therefore its own process group.  This allows us to kill the whole
        # process group using `kill -- -${pid_of_group_leader}`
        #
        # This is something that the short-tail and tail-with-header programs
        # should handle.
        setsid --wait ${tail} ${files[0]} &
        tail_pid=$!
    fi
    sleep ${poll_seconds}
done
