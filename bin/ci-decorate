#!/usr/bin/env bash

main(){
    local ps1=${1:-$ }
    printf "ps1='%s';" "${ps1}"
    while read -r line; do
        case "${line}" in
            ""|'##'*) printf "\n" ;;
            '#'*) printf "printf '%s' '$(escape "${line}")'\n" \
                "\033[34m%s\033[0m\n" ;;
            *) printf 'printf "%s" "${ps1@P}" "%s"; %s\n' \
                "\033[1;32m%s %s\033[0m\n" \
                "$(escape "${line}")" \
                "${line}"
        esac
    done
}

escape(){
    line="$1"
    escaped=${line//\\/\\\\}
    escaped=${escaped//$/\\$}
    escaped=${escaped//'"'/\\'"'}
    echo "${escaped}"
}

main "$@"
