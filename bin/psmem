#!/usr/bin/env python3
import psutil
import os
import argparse
import sys

"""
Get memory usage of a process or processes
"""

def get_args():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("pids", metavar='PID', nargs='*', type=int, help="Process ID(s) to get memory info for", default=[os.getppid()])
    return p.parse_args()

def main():
    args = get_args()
    print(f"{'PID':<10}\t{'MEM':<10}\tCMD")
    for proc in (psutil.Process(pid) for pid in args.pids):
        print(f"\033[1;37m{str(proc.pid):<10}\033[0m\t\033[32m{get_memory_usage_str(proc, args):<10}\t\033[36m{' '.join(proc.cmdline()).strip()}\033[0m")

def select_unit(nbytes):
    if nbytes < 1000:
        return 'B'
    if nbytes < 10e6:
        return 'K'
    if nbytes < 10e9:
        return 'M'
    return 'G'

def get_memory_usage_str(proc, args):
    factors = { 'B': 1, 'K': 10e3, 'M': 10e6, 'G': 10e9 }
    nbytes = proc.memory_info().rss
    unit = select_unit(nbytes)
    n_unit = nbytes / factors[unit]
    return f"{n_unit:.2f}{unit}"

if __name__ == "__main__":
    sys.exit(main())
